{{- /*
  Content adapter: one page per repo you own and have pinned on your GitHub profile or starred.
  Each page uses the repo's README as its body. Runs at build time.
  No token needed: a build makes two GitHub API requests (repo list, stars); READMEs come from
  raw.githubusercontent.com and pins from the public profile page. HUGO_GITHUB_TOKEN (optional)
  raises the API limit from 60 to 5,000 requests an hour. A failed fetch stops the build, so the
  previous complete build keeps serving instead of a partial one.
*/ -}}
{{- $user := site.Params.github.user -}}
{{- $cfg := hugo.Data.projects | default dict -}}
{{- $hide := $cfg.hide | default slice -}}

{{- $headers := dict "Accept" "application/vnd.github+json" "X-GitHub-Api-Version" "2022-11-28" -}}
{{- with os.Getenv "HUGO_GITHUB_TOKEN" -}}
  {{- $headers = merge $headers (dict "Authorization" (printf "Bearer %s" .)) -}}
{{- end -}}

{{- /* Pinned repos, in profile order, read from the public profile page (no token needed). */ -}}
{{- $pinned := slice -}}
{{- $profileURL := printf "https://github.com/%s" $user -}}
{{- with try (resources.GetRemote $profileURL (dict "headers" (dict "User-Agent" "blog-builder (Hugo)"))) -}}
  {{- with .Err -}}
    {{- errorf "projects: could not read pinned repos from %s: %s" $profileURL . -}}
  {{- else with .Value -}}
    {{- range findRESubmatch (printf `(?i)href="/%s/([^"/]+)"[^>]*>\s*<span class="repo"` $user) .Content -}}
      {{- $pinned = $pinned | append (index . 1) -}}
    {{- end -}}
    {{- if not $pinned -}}{{- warnf "projects: no pinned repos found on %s; GitHub may have changed the page" $profileURL -}}{{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Starred repos that you own (stars on other people's repos are ignored). */ -}}
{{- $starred := slice -}}
{{- range $page := seq 10 -}}
  {{- $url := printf "https://api.github.com/users/%s/starred?per_page=100&page=%d" $user $page -}}
  {{- $batch := slice -}}
  {{- with try (resources.GetRemote $url (dict "headers" $headers)) -}}
    {{- with .Err -}}{{- errorf "projects: could not list starred repos: %s" . -}}
    {{- else with .Value -}}{{- $batch = . | transform.Unmarshal -}}{{- end -}}
  {{- end -}}
  {{- range $batch -}}
    {{- if eq (lower .owner.login) (lower $user) -}}{{- $starred = $starred | append .name -}}{{- end -}}
  {{- end -}}
  {{- if lt (len $batch) 100 -}}{{- break -}}{{- end -}}
{{- end -}}

{{- $selected := union $pinned $starred -}}

{{- $listURL := printf "https://api.github.com/users/%s/repos?type=owner&per_page=100&sort=pushed" $user -}}
{{- $repos := slice -}}
{{- with try (resources.GetRemote $listURL (dict "headers" $headers)) -}}
  {{- with .Err -}}
    {{- errorf "projects: could not list GitHub repos: %s" . -}}
  {{- else with .Value -}}
    {{- $repos = . | transform.Unmarshal -}}
  {{- end -}}
{{- end -}}

{{- range $repos -}}
  {{- if or .private (not (in $selected .name)) (in $hide .name) -}}{{- continue -}}{{- end -}}

  {{- $repo := . -}}
  {{- $raw := printf "https://raw.githubusercontent.com/%s/%s/" .full_name .default_branch -}}

  {{- /* README from raw.githubusercontent.com (not counted against the API rate limit).
         A missing file is fine; any other failure stops the build so the last good build keeps serving. */ -}}
  {{- $readme := "" -}}
  {{- range slice "README.md" "readme.md" "Readme.md" "README.markdown" "README" -}}
    {{- if not $readme -}}
      {{- with try (resources.GetRemote (printf "%s%s" $raw .)) -}}
        {{- with .Err -}}{{- errorf "projects: could not fetch the README for %s: %s" $repo.name . -}}
        {{- else with .Value -}}{{- $readme = .Content -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- /* Icon: an override in data/projects.yaml, else the first README image whose alt text or
         path mentions "logo" or "icon" (badges excluded). Resolved before READMEs are rewritten. */ -}}
  {{- $icon := "" -}}
  {{- $candidates := slice -}}
  {{- range findRESubmatch `(?i)<img[^>]*?\ssrc="([^"]+)"[^>]*>` $readme -}}
    {{- $candidates = $candidates | append (dict "match" (index . 0) "src" (index . 1)) -}}
  {{- end -}}
  {{- range findRESubmatch `!\[([^\]]*)\]\(([^)\s]+)` $readme -}}
    {{- $candidates = $candidates | append (dict "match" (index . 0) "src" (index . 2)) -}}
  {{- end -}}
  {{- range $candidates -}}
    {{- if and (not $icon) (findRE `(?i)logo|icon` .match) (not (findRE `(?i)shields\.io|badge|/workflows/` .match)) -}}
      {{- $icon = cond (hasPrefix .src "http") .src (printf "%s%s" $raw (strings.TrimLeft "./" .src)) -}}
      {{- /* The page header shows the icon, so drop it from the README body. */ -}}
      {{- $readme = replace $readme .match "" 1 -}}
    {{- end -}}
  {{- end -}}
  {{- with index ($cfg.icons | default dict) .name -}}
    {{- $icon = cond (hasPrefix . "http") . (printf "%s%s" $raw (strings.TrimLeft "./" .)) -}}
  {{- end -}}

  {{- /* The page already shows the repo name as its title. */ -}}
  {{- $readme = replaceRE (printf `(?im)^[ \t]*#[ \t]+%s[ \t]*$` (.name | replaceRE `([.\\+*?()|\[\]{}^$])` `\$1`)) "" $readme 1 -}}
  {{- /* Raw HTML <img src="relative"> bypasses render hooks, so point it at the repo here. */ -}}
  {{- $readme = replaceRE `(<img[^>]*?\ssrc=")(?:\./|/)?([^":#]+")` (printf "${1}%s${2}" $raw) $readme -}}
  {{- if not $readme -}}
    {{- $readme = printf "This repository has no README yet. [Browse it on GitHub](%s)." .html_url -}}
  {{- end -}}

  {{- $rank := 0 -}}
  {{- range $i, $name := $pinned -}}
    {{- if eq $name $repo.name -}}{{- $rank = add $i 1 -}}{{- end -}}
  {{- end -}}

  {{- $.AddPage (dict
    "kind" "page"
    "path" (lower .name)
    "title" .name
    "description" (.description | default "")
    "dates" (dict "date" (time.AsTime .created_at) "lastmod" (time.AsTime .pushed_at))
    "params" (dict
      "description" (.description | default "")
      "repo_url" .html_url
      "full_name" .full_name
      "default_branch" .default_branch
      "homepage" (.homepage | default "")
      "language" (.language | default "")
      "stars" .stargazers_count
      "fork" .fork
      "topics" (.topics | default slice)
      "icon_url" $icon
      "pinned_rank" $rank
      "hiddenInRss" true
    )
    "content" (dict "mediaType" "text/markdown" "value" $readme)
  ) -}}
{{- end -}}
