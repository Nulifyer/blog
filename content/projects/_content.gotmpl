{{- /*
  Content adapter: one page per repo you own and have pinned on your GitHub profile or starred.
  Each page uses the repo's README as its body. Runs at build time.
  Pinned repos need HUGO_GITHUB_TOKEN (GitHub's GraphQL API requires a token); the workflow passes
  one. Without a token, only starred repos are listed.
*/ -}}
{{- $user := site.Params.github.user -}}
{{- $cfg := hugo.Data.projects | default dict -}}
{{- $hide := $cfg.hide | default slice -}}

{{- $token := os.Getenv "HUGO_GITHUB_TOKEN" -}}
{{- $headers := dict "Accept" "application/vnd.github+json" "X-GitHub-Api-Version" "2022-11-28" -}}
{{- with $token -}}
  {{- $headers = merge $headers (dict "Authorization" (printf "Bearer %s" .)) -}}
{{- end -}}

{{- /* Pinned repos, in profile order. */ -}}
{{- $pinned := slice -}}
{{- if $token -}}
  {{- $query := printf `{ user(login: %q) { pinnedItems(first: 6, types: REPOSITORY) { nodes { ... on Repository { name owner { login } } } } } }` $user -}}
  {{- $opts := dict "method" "post" "body" (dict "query" $query | jsonify) "headers" (merge $headers (dict "Content-Type" "application/json")) -}}
  {{- with try (resources.GetRemote "https://api.github.com/graphql" $opts) -}}
    {{- with .Err -}}
      {{- errorf "projects: could not read pinned repos: %s" . -}}
    {{- else with .Value -}}
      {{- $data := . | transform.Unmarshal -}}
      {{- with $data.errors -}}{{- errorf "projects: pinned repos query failed: %v" . -}}{{- end -}}
      {{- range $data.data.user.pinnedItems.nodes -}}
        {{- if eq (lower .owner.login) (lower $user) -}}{{- $pinned = $pinned | append .name -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- warnf "projects: HUGO_GITHUB_TOKEN is not set, so pinned repos are skipped" -}}
{{- end -}}

{{- /* Starred repos that you own (stars on other people's repos are ignored). */ -}}
{{- $starred := slice -}}
{{- range $page := seq 10 -}}
  {{- $url := printf "https://api.github.com/users/%s/starred?per_page=100&page=%d" $user $page -}}
  {{- $batch := slice -}}
  {{- with try (resources.GetRemote $url (dict "headers" $headers)) -}}
    {{- with .Err -}}{{- errorf "projects: could not list starred repos: %s" . -}}
    {{- else with .Value -}}{{- $batch = . | transform.Unmarshal -}}{{- end -}}
  {{- end -}}
  {{- range $batch -}}
    {{- if eq (lower .owner.login) (lower $user) -}}{{- $starred = $starred | append .name -}}{{- end -}}
  {{- end -}}
  {{- if lt (len $batch) 100 -}}{{- break -}}{{- end -}}
{{- end -}}

{{- $selected := union $pinned $starred -}}

{{- $listURL := printf "https://api.github.com/users/%s/repos?type=owner&per_page=100&sort=pushed" $user -}}
{{- $repos := slice -}}
{{- with try (resources.GetRemote $listURL (dict "headers" $headers)) -}}
  {{- with .Err -}}
    {{- errorf "projects: could not list GitHub repos: %s" . -}}
  {{- else with .Value -}}
    {{- $repos = . | transform.Unmarshal -}}
  {{- end -}}
{{- end -}}

{{- range $repos -}}
  {{- if or .private (not (in $selected .name)) (in $hide .name) -}}{{- continue -}}{{- end -}}

  {{- $repo := . -}}
  {{- $raw := printf "https://raw.githubusercontent.com/%s/%s/" .full_name .default_branch -}}

  {{- $readme := "" -}}
  {{- $readmeURL := printf "https://api.github.com/repos/%s/readme" .full_name -}}
  {{- with try (resources.GetRemote $readmeURL (dict "headers" $headers)) -}}
    {{- with .Err -}}
      {{- if not (strings.Contains . "404") -}}{{- warnf "projects: README for %s: %s" $repo.name . -}}{{- end -}}
    {{- else with .Value -}}
      {{- with (. | transform.Unmarshal).content -}}{{- $readme = replace . "\n" "" | base64Decode -}}{{- end -}}
    {{- end -}}
  {{- end -}}
  {{- /* The page already shows the repo name as its title. */ -}}
  {{- $readme = replaceRE `\A\s*#[ \t]+[^\n]*\n` "" $readme 1 -}}
  {{- /* Raw HTML <img src="relative"> bypasses render hooks, so point it at the repo here. */ -}}
  {{- $readme = replaceRE `(<img[^>]*?\ssrc=")(?:\./|/)?([^":#]+")` (printf "${1}%s${2}" $raw) $readme -}}
  {{- if not $readme -}}
    {{- $readme = printf "This repository has no README yet. [Browse it on GitHub](%s)." .html_url -}}
  {{- end -}}

  {{- $rank := 0 -}}
  {{- range $i, $name := $pinned -}}
    {{- if eq $name $repo.name -}}{{- $rank = add $i 1 -}}{{- end -}}
  {{- end -}}

  {{- $.AddPage (dict
    "kind" "page"
    "path" (lower .name)
    "title" .name
    "dates" (dict "date" (time.AsTime .created_at) "lastmod" (time.AsTime .pushed_at))
    "params" (dict
      "description" (.description | default "")
      "repo_url" .html_url
      "full_name" .full_name
      "default_branch" .default_branch
      "homepage" (.homepage | default "")
      "language" (.language | default "")
      "stars" .stargazers_count
      "fork" .fork
      "tags" (.topics | default slice)
      "featured_rank" $rank
    )
    "content" (dict "mediaType" "text/markdown" "value" $readme)
  ) -}}
{{- end -}}
